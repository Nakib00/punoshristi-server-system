# Port the local WebSocket server listens on. The kiosk web app (running on
# this same device) connects to ws://localhost:<this port>.
PORT=5055

# --- Arduino mode (laptop + Arduino Uno/Nano over USB) -----------------------
# For testing without a Raspberry Pi: set this to the Arduino's serial port
# and this bridge reads START/STOP/BOTTLE lines from arduino/punoshristi_kiosk_bridge.ino
# instead of GPIO pins. Leave commented out to use Pi GPIO (below) or, if
# that's unavailable too, the keyboard simulator.
#   Windows: check Device Manager > Ports (COM & LPT), e.g. COM3
#   Mac:     ls /dev/cu.*      e.g. /dev/cu.usbmodem14101
#   Linux:   ls /dev/tty*      e.g. /dev/ttyACM0 or /dev/ttyUSB0
#ARDUINO_PORT=COM3
ARDUINO_BAUD_RATE=9600

# --- Raspberry Pi GPIO mode ---------------------------------------------------
# BCM pin numbers (not physical header pin numbers). Only used when
# ARDUINO_PORT above is not set. See README/circuit diagram in
# server/README.md for the full wiring reference.
START_BUTTON_PIN=17
STOP_BUTTON_PIN=27
IR_SENSOR_PIN=22
BUZZER_PIN=23

# Most cheap IR obstacle/proximity modules (e.g. FC-51) pull their OUT pin
# LOW when a bottle breaks the beam and HIGH when clear. If your bottles
# aren't being counted (or are double-counted) at rest, flip this.
IR_ACTIVE_LOW=true

# Minimum milliseconds between two IR "bottle detected" events. Filters
# sensor bounce/noise from a single bottle passing without missing fast
# back-to-back drops.
IR_DEBOUNCE_MS=300

# Button debounce, in milliseconds.
BUTTON_DEBOUNCE_MS=50
