# Port the local WebSocket server listens on. The kiosk web app (running in
# Chromium on the same Pi) connects to ws://localhost:<this port>.
PORT=5055

# BCM pin numbers (not physical header pin numbers). See README/circuit
# diagram in server/README.md for the full wiring reference.
START_BUTTON_PIN=17
STOP_BUTTON_PIN=27
IR_SENSOR_PIN=22
BUZZER_PIN=23

# Most cheap IR obstacle/proximity modules (e.g. FC-51) pull their OUT pin
# LOW when a bottle breaks the beam and HIGH when clear. If your bottles
# aren't being counted (or are double-counted) at rest, flip this.
IR_ACTIVE_LOW=true

# Minimum milliseconds between two IR "bottle detected" events. Filters
# sensor bounce/noise from a single bottle passing without missing fast
# back-to-back drops.
IR_DEBOUNCE_MS=300

# Button debounce, in milliseconds.
BUTTON_DEBOUNCE_MS=50
