VITE_API_BASE_URL=http://localhost:4000/api

# Local GPIO bridge daemon (server/kiosk-gpio-bridge) — runs on this same
# kiosk device, default is fine unless you changed its PORT.
VITE_GPIO_BRIDGE_URL=http://localhost:5055

# Set this to lock the kiosk to one machine (skips the manual picker).
# Get the id from the admin panel's Machines page or GET /api/machines.
# VITE_MACHINE_ID=
